{
  "$defs": {
    "AssessmentLink": {
      "additionalProperties": false,
      "properties": {
        "assessment_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Assessment Ids",
          "type": "array"
        },
        "claim_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "assessment_ids"
      ],
      "title": "AssessmentLink",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "default": "unassessed",
          "enum": [
            "unassessed",
            "supported",
            "contested",
            "insufficient",
            "refuted"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "claim_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source_statement",
            "observation",
            "inference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "qualifiers": {
          "items": {
            "maxLength": 100000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Qualifiers",
          "type": "array"
        },
        "temporal_scope": {
          "default": "current",
          "enum": [
            "current",
            "historical"
          ],
          "title": "Temporal Scope",
          "type": "string"
        },
        "text": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "kind",
        "qualifiers"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "conflict_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Conflict Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 2,
          "title": "Evidence Ids",
          "type": "array"
        },
        "question_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "conflict_id",
        "claim_id",
        "question_id",
        "evidence_ids",
        "reason"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quote_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Digest",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "evidence_id",
        "snapshot_id",
        "start",
        "end",
        "quote",
        "quote_digest"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FixtureArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "conflict_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Conflict Ids",
          "type": "array"
        },
        "layer": {
          "enum": [
            "summary",
            "analysis",
            "dossier"
          ],
          "title": "Layer",
          "type": "string"
        },
        "question_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Question Ids",
          "type": "array"
        },
        "statements": {
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Statements",
          "type": "array"
        }
      },
      "required": [
        "artifact_id",
        "layer",
        "statements",
        "question_ids",
        "conflict_ids"
      ],
      "title": "FixtureArtifact",
      "type": "object"
    },
    "FixtureAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "checked_input": {
          "$ref": "#/$defs/VerificationInput"
        },
        "checked_input_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checked Input Digest",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "supported",
            "contested",
            "insufficient",
            "refuted"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "assessment_id",
        "checked_input",
        "checked_input_digest",
        "outcome",
        "checked_at",
        "reason"
      ],
      "title": "FixtureAssessment",
      "type": "object"
    },
    "FixtureRenderAudit": {
      "additionalProperties": false,
      "properties": {
        "audit_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Audit Id",
          "type": "string"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "checked_input": {
          "$ref": "#/$defs/RenderInput"
        },
        "checked_input_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checked Input Digest",
          "type": "string"
        },
        "checked_output_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checked Output Digest",
          "type": "string"
        },
        "reason": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "indeterminate"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "audit_id",
        "checked_input",
        "checked_input_digest",
        "verdict",
        "checked_output_digest",
        "checked_at",
        "reason"
      ],
      "title": "FixtureRenderAudit",
      "type": "object"
    },
    "FixtureResearch": {
      "additionalProperties": false,
      "properties": {
        "conflicts": {
          "items": {
            "$ref": "#/$defs/Conflict"
          },
          "maxItems": 100,
          "title": "Conflicts",
          "type": "array"
        },
        "objective": {
          "anyOf": [
            {
              "maxLength": 100000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/QuestionOutcome"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        },
        "verifications": {
          "$ref": "#/$defs/FixtureVerificationSet"
        }
      },
      "required": [
        "verifications",
        "questions",
        "conflicts"
      ],
      "title": "FixtureResearch",
      "type": "object"
    },
    "FixtureVerification": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "checked_input": {
          "$ref": "#/$defs/VerificationInput"
        },
        "checked_input_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checked Input Digest",
          "type": "string"
        },
        "reason": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "indeterminate"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "verification_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Verification Id",
          "type": "string"
        }
      },
      "required": [
        "verification_id",
        "checked_input",
        "checked_input_digest",
        "verdict",
        "checked_at",
        "reason"
      ],
      "title": "FixtureVerification",
      "type": "object"
    },
    "FixtureVerificationSet": {
      "additionalProperties": false,
      "description": "Binds recorded judgments to trusted expected context, never auto-approves.",
      "properties": {
        "assessment_links": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssessmentLink"
          },
          "maxItems": 1000,
          "title": "Assessment Links",
          "type": "array"
        },
        "assessments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FixtureAssessment"
          },
          "maxItems": 3000,
          "title": "Assessments",
          "type": "array"
        },
        "policy_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/FixtureVerification"
          },
          "maxItems": 3000,
          "title": "Records",
          "type": "array"
        },
        "schema_version": {
          "const": "fixture-verifications/1",
          "title": "Schema Version",
          "type": "string"
        },
        "structure": {
          "$ref": "#/$defs/KnowledgeStructure"
        },
        "verifier": {
          "$ref": "#/$defs/FixtureVerifier"
        }
      },
      "required": [
        "schema_version",
        "structure",
        "policy_version",
        "verifier",
        "records"
      ],
      "title": "FixtureVerificationSet",
      "type": "object"
    },
    "FixtureVerifier": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Identity",
          "type": "string"
        },
        "kind": {
          "const": "fixture_expectation",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "identity",
        "version"
      ],
      "title": "FixtureVerifier",
      "type": "object"
    },
    "FreshnessBasis": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "published_at",
            "effective_at",
            "historical_snapshot",
            "unknown"
          ],
          "title": "Basis",
          "type": "string"
        },
        "max_age_seconds": {
          "maximum": 315576000,
          "minimum": 0,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "reason": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "basis",
        "max_age_seconds",
        "reason"
      ],
      "title": "FreshnessBasis",
      "type": "object"
    },
    "FreshnessContext": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/FreshnessBasis"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "policy_version",
        "evaluated_at",
        "as_of",
        "sources"
      ],
      "title": "FreshnessContext",
      "type": "object"
    },
    "KnowledgeStructure": {
      "additionalProperties": false,
      "description": "One self-contained, scoped revision; assessment never implies verification.",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 1000,
          "title": "Claims",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 1000,
          "title": "Evidence",
          "type": "array"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "maxItems": 2000,
          "title": "Relationships",
          "type": "array"
        },
        "research_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Research Id",
          "type": "string"
        },
        "revision_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Revision Id",
          "type": "string"
        },
        "schema_version": {
          "const": "knowledge-structure-prototype/1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "snapshots": {
          "items": {
            "$ref": "#/$defs/Snapshot"
          },
          "maxItems": 100,
          "title": "Snapshots",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "scope_id",
        "research_id",
        "revision_id",
        "snapshots",
        "evidence",
        "claims",
        "relationships"
      ],
      "title": "KnowledgeStructure",
      "type": "object"
    },
    "QuestionOutcome": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "question_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "report_claim_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Report Claim Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "answered",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "question",
        "status",
        "report_claim_id"
      ],
      "title": "QuestionOutcome",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "maxLength": 100000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Assumptions",
          "type": "array"
        },
        "kind": {
          "enum": [
            "supports",
            "contradicts",
            "derived_from"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rationale": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "relationship_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Relationship Id",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "maxLength": 100000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "relationship_id",
        "kind",
        "source_id",
        "target_id",
        "rationale"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "RenderInput": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/FixtureArtifact"
        },
        "artifact_set_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Artifact Set Id",
          "type": "string"
        },
        "auditor": {
          "$ref": "#/$defs/FixtureVerifier"
        },
        "renderer_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Renderer Version",
          "type": "string"
        },
        "research": {
          "$ref": "#/$defs/FixtureResearch"
        },
        "schema_version": {
          "const": "fixture-render-input/1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "research",
        "artifact_set_id",
        "renderer_version",
        "artifact",
        "auditor"
      ],
      "title": "RenderInput",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "canonical_url": {
          "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$",
          "title": "Canonical Url",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "effective_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lineage_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lineage Id"
        },
        "media_type": {
          "enum": [
            "text/plain",
            "text/markdown"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "normalization_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Normalization Version",
          "type": "string"
        },
        "origin_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Id"
        },
        "published_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "text": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "canonical_url",
        "retrieved_at",
        "normalization_version",
        "media_type",
        "text",
        "digest"
      ],
      "title": "Snapshot",
      "type": "object"
    },
    "SourceDate": {
      "additionalProperties": false,
      "description": "A recorded source date and its provenance, not an authenticated assertion.",
      "properties": {
        "provenance": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "value": {
          "format": "date-time",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "title": "SourceDate",
      "type": "object"
    },
    "Statement": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Evidence Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "claim_ids",
        "evidence_ids"
      ],
      "title": "Statement",
      "type": "object"
    },
    "VerificationInput": {
      "additionalProperties": false,
      "description": "Full structural context prevents a quote-only verdict from hiding context.",
      "properties": {
        "check_type": {
          "enum": [
            "semantic_support",
            "freshness",
            "conflict_coverage",
            "assessment"
          ],
