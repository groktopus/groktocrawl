def _evidence_budget_arg(value: str) -> int:
    number = int(value)
    if not 256 <= number <= 128_000:
        raise argparse.ArgumentTypeError(
            "Evidence budget must be 256..128000 characters"
        )
    return number


def _evidence_offset_arg(value: str) -> int:
    number = int(value)
    if number < 0:
        raise argparse.ArgumentTypeError("Evidence offset must be nonnegative")
    return number


def _evidence_digest_arg(value: str) -> str:
    if not re.fullmatch(r"[0-9a-f]{64}", value):
        raise argparse.ArgumentTypeError(
            "Expected digest must be 64 lowercase hexadecimal characters"
        )
    return value


def cmd_agent(client: Client, args: argparse.Namespace) -> None:
    if client.dry_run:
        emit(
            f"[dry-run] Would start agent: {args.prompt}",
            {"dry_run": True, "command": "agent"},
        )
        return

    pyramid_mode = args.pyramid or bool(args.output_dir)
    output_dir = args.output_dir or (
        _default_output_dir(args.prompt) if pyramid_mode else ""
    )

    if pyramid_mode:
        log(f"Agent researching... (pyramid output to {output_dir})")

    try:
        include_images = getattr(args, "include_images", False)
        search_type = getattr(args, "search_type", "deep")
        evidence_options = {}
        if vars(args).get("evidence_budget_chars") is not None:
            evidence_options["evidence_budget_chars"] = args.evidence_budget_chars
        # Only argparse-populated fields participate. This keeps partial
        # legacy callers compatible while passing explicit values through for
        # API validation, including invalid ones.
        if args.sync:
            # Non-streaming path: create job and poll
            agent_kwargs: dict[str, Any] = {
                "prompt": args.prompt,
                "urls": args.urls,
                "schema": None,
                "include_images": include_images,
                "search_type": search_type,
                "retry": True,
            }
            if pyramid_mode:
                agent_kwargs["include_source_content"] = True
            result = client.create_agent(
                **agent_kwargs,
                **evidence_options,
            )
        else:
            # Streaming path (default)
            agent_kwargs = {
                "prompt": args.prompt,
                "urls": args.urls,
                "include_images": include_images,
                "search_type": search_type,
                "retry": True,
            }
            if pyramid_mode:
                agent_kwargs["include_source_content"] = True
            result = client.create_agent_stream(**agent_kwargs, **evidence_options)
    except ApiError as e:
        die(e)

    if args.sync:
        # Poll loop (non-streaming)
        job_id = result.get("id", "")
        if not job_id:
            print("\nError: No job ID returned from agent endpoint", flush=True)
            sys.exit(1)

        if args.no_poll:
            if JSON_OUTPUT:
                emit(f"Agent job: {job_id}", {"job_id": job_id, "status": "started"})
            else:
                log(f"Agent job ID: {job_id}")
            return

        if not pyramid_mode:
            log(f"Agent job {job_id} — researching...")
        while True:
            time.sleep(POLL_INTERVAL)
            try:
                status = client.agent_status(job_id)
            except ApiError as e:
                warn(f"Status check failed: {e}")
                continue

            s = status.get("status", "unknown")
            if s == "completed":
                data = status.get("data", {})
                result_text = data.get("result", "(no result)")
                sources = data.get("sources", [])
                source_details = data.get("source_details", [])
                source_contents = data.get("source_contents", {})

                if pyramid_mode:
                    try:
                        path = _write_pyramid(
                            output_dir=output_dir,
                            query=args.prompt,
                            result_text=result_text,
                            sources=sources,
                            citations=[],
                            source_details=source_details,
                            source_contents=source_contents,
                        )
                    except ValueError as exc:
                        die(exc)
                    emit(path, {"pyramid": path})
                elif JSON_OUTPUT:
                    emit("", {"job_id": job_id, "status": "completed", "result": data})
                else:
                    print(f"\n{result_text}\n")
                    if sources:
                        print("Sources:")
                        for src in sources:
                            print(f"  {src}")
                return
            elif s == "failed":
                err_msg = status.get("error", "unknown")
                print(f"\nError: Agent failed — {err_msg}", flush=True)
                sys.exit(1)
            else:
                info(f"  Status: {s}")
    else:
        # Streaming path: read SSE events from the stream
        resp = result["_stream"]
        sources_shown = False
        full_result = ""
        agent_sources = []
        agent_source_details = []
        agent_source_contents = {}
        evidence_coverage = None
        for line in resp.iter_lines(decode_unicode=True):
            if not line or not line.startswith("data: "):
                continue
            data_str = line[6:].strip()
            if data_str == "[DONE]":
                break
            try:
                event = json.loads(data_str)
                if event["type"] == "sources_pending" and not sources_shown:
                    if event.get("sources"):
                        if not pyramid_mode:
                            log(f"Found {len(event['sources'])} sources...")
                elif event["type"] == "source_scraped":
                    url = event.get("url", "")
                    chars = event.get("chars", 0)
                    info(f"  Scraped: {url} ({chars} chars)")
                elif event["type"] == "sources" and not sources_shown:
                    if event.get("sources"):
                        agent_sources = event["sources"]
                        if not pyramid_mode:
                            log("Sources:")
                            for s in event["sources"]:
                                log("  " + s)
                    sources_shown = True
                elif event["type"] == "token":
                    full_result += event["content"]
                    if not pyramid_mode and not JSON_OUTPUT:
                        print(event["content"], end="", flush=True)
                elif event["type"] == "done":
                    full_result = event.get("result", full_result)
                    agent_source_details = event.get("source_details", [])
                    agent_source_contents = event.get("source_contents", {})
                    evidence_coverage = event.get("evidence_coverage")
                    if not pyramid_mode and not JSON_OUTPUT:
                        print()
                elif event["type"] == "error":
                    if JSON_OUTPUT and not pyramid_mode:
                        payload = {
                            "success": False,
                            "error": event.get("content", "Agent stream failed"),
                        }
                        for key in ("classification", "retry_after_seconds"):
                            if key in event:
                                payload[key] = event[key]
                        emit("", payload)
                        sys.exit(1)
                    print(f"\nError: {event['content']}", flush=True)
                    sys.exit(1)
            except json.JSONDecodeError:
                continue

        if pyramid_mode:
            # Write pyramid from captured SSE result
            try:
                path = _write_pyramid(
                    output_dir=output_dir,
                    query=args.prompt,
                    result_text=full_result,
                    sources=agent_sources,
                    citations=[],
                    source_details=agent_source_details,
                    source_contents=agent_source_contents,
                )
            except ValueError as exc:
                die(exc)
            emit(path, {"pyramid": path})
        elif JSON_OUTPUT:
            payload = {"result": full_result, "sources": agent_sources}
            if evidence_coverage is not None:
                payload["evidence_coverage"] = evidence_coverage
            emit("", payload)
        elif not sources_shown and full_result:
            print(full_result)


def cmd_answer(client: Client, args: argparse.Namespace) -> None:
    """Grounded Q&A: one call, cited answer."""
    if client.dry_run:
        emit(
            f"[dry-run] Would answer: {args.query}",
            {"dry_run": True, "command": "answer"},
        )
        return

    pyramid_mode = args.pyramid or bool(args.output_dir)
    output_dir = args.output_dir or (
        _default_output_dir(args.query) if pyramid_mode else ""
    )

    if pyramid_mode:
        log(f"Answering... (pyramid output to {output_dir})")

    evidence_options = {}
    if vars(args).get("evidence_budget_chars") is not None:
        evidence_options["evidence_budget_chars"] = args.evidence_budget_chars
    try:
        result = client.answer(
            query=args.query,
            num_sources=args.num_sources,
            stream=not args.sync,
            retry=True,
            **evidence_options,
            **({"include_source_content": True} if pyramid_mode else {}),
        )
    except ApiError as e:
        die(e)

    if not args.sync:
        resp = result["_stream"]
        sources_shown = False
        full_answer = ""
        citations = []
        answer_sources = []
        source_contents = {}
        evidence_coverage = None
        for line in resp.iter_lines(decode_unicode=True):
            if not line or not line.startswith("data: "):
                continue
            data_str = line[6:].strip()
            if data_str == "[DONE]":
                break
            try:
                event = json.loads(data_str)
                if event["type"] == "sources" and not sources_shown:
                    if event.get("sources"):
                        answer_sources = event["sources"]
                        if not pyramid_mode:
                            log("Sources:")
                            for s in event["sources"]:
                                log("  " + s["url"])
                    sources_shown = True
                elif event["type"] == "token":
                    full_answer += event["content"]
                    if not pyramid_mode:
                        print(event["content"], end="", flush=True)
                elif event["type"] == "done":
                    full_answer = event.get("answer", full_answer)
                    citations = event.get("citations", [])
                    evidence_coverage = event.get("evidence_coverage")
                    source_contents = event.get("source_contents", {})
                    if not pyramid_mode:
                        print()
                elif event["type"] == "error":
                    die("Error: " + event["content"])
            except json.JSONDecodeError:
                continue

        if pyramid_mode:
            path = _write_pyramid(
                output_dir=output_dir,
                query=args.query,
                result_text=full_answer,
                sources=answer_sources,
                citations=citations,
                source_contents=source_contents,
            )
            emit(path, {"pyramid": path})
        else:
            if citations and not JSON_OUTPUT:
                print("\nCitations:")
                for c in citations:
                    print("  [{}] {}".format(c["index"], c["url"]))
            if JSON_OUTPUT:
                payload = {"answer": full_answer, "citations": citations}
                if evidence_coverage is not None:
                    payload["evidence_coverage"] = evidence_coverage
                emit("", payload)
        return

    if pyramid_mode:
        # Sync path, pyramid mode
        path = _write_pyramid(
            output_dir=output_dir,
            query=args.query,
            result_text=result.get("answer", ""),
            sources=result.get("sources", []),
            citations=result.get("citations", []),
            source_contents=result.get("source_contents", {}),
        )
        emit(path, {"pyramid": path})
    elif JSON_OUTPUT:
        emit(
            "",
            {
                "answer": result.get("answer", ""),
                "sources": result.get("sources", []),
                "citations": result.get("citations", []),
                **(
                    {"evidence_coverage": result["evidence_coverage"]}
                    if "evidence_coverage" in result
                    else {}
                ),
            },
        )
    else:
        answer = result.get("answer", "")
        sources = result.get("sources", [])
        citations = result.get("citations", [])
        print("\n" + answer + "\n")
        if sources:
            print("Sources:")
            for s in sources:
                print("  {} — {}".format(s.get("title", ""), s["url"]))
        if citations:
            print("\nCitations:")
            for c in citations:
                print("  [{}] {}".format(c["index"], c["url"]))


def cmd_enrich(client: Client, args: argparse.Namespace) -> None:
    """Enrich a list of entities with web-sourced structured data."""
    # Parse items from JSON string or file
    items_str = args.items
    if items_str.startswith("@"):
        with open(items_str[1:]) as f:
            items_str = f.read()
    try:
        items = json.loads(items_str)
        if not isinstance(items, list):
            die("--items must be a JSON array")
    except (json.JSONDecodeError, FileNotFoundError) as e:
        die(f"Invalid --items: {e}")

    # Parse fields from JSON string or file
    fields_str = args.fields
    if fields_str.startswith("@"):
        with open(fields_str[1:]) as f:
            fields_str = f.read()
    try:
        fields_raw = json.loads(fields_str)
        if not isinstance(fields_raw, dict):
            die("--fields must be a JSON object")
        # Convert to the format expected by the API: {name: {description: ...}}
        fields = {
            name: {
                "description": desc
                if isinstance(desc, str)
                else desc.get("description", str(desc))
            }
            for name, desc in fields_raw.items()
        }
    except (json.JSONDecodeError, FileNotFoundError) as e:
        die(f"Invalid --fields: {e}")

    # Store parsed values on args for the handler
    args._items = items
    args._fields = fields

    if client.dry_run:
        emit(
            f"[dry-run] Would enrich {len(args._items)} items with {len(args._fields)} fields",
            {"dry_run": True, "command": "enrich"},
        )
        return

    try:
        result = client.enrich(
            items=args._items,
            fields=args._fields,
            source_hint=args.source_hint,
            effort=args.effort,
        )
    except ApiError as e:
        die(e)

    if JSON_OUTPUT:
        emit("", result)
        return

    data = result.get("data", [])
    if not data:
        log("No enrichment results")
        return

    for i, enriched in enumerate(data):
        item = enriched.get("item", {})
        enrichments = enriched.get("enrichments", {})
        print(f"\n--- Item {i + 1}: {item} ---")
        for field_name, field_value in enrichments.items():
            val = field_value.get("value", "")
            src = field_value.get("source", "")
            print(f"  {field_name}: {val or '(not found)'}")
            if src:
                print(f"    source: {src}")
    print()


