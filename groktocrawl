def cmd_crawl(client: Client, args: argparse.Namespace) -> None:
    if client.dry_run:
        emit(
            f"[dry-run] Would crawl: {args.url}", {"dry_run": True, "command": "crawl"}
        )
        return

    try:
        extra: dict[str, Any] = {}
        crawl_format = getattr(args, "format", None)
        if isinstance(crawl_format, list) and crawl_format:
            extra["scrape_options"] = {"formats": crawl_format}
        result = client.crawl(
            url=args.url,
            limit=args.limit,
            max_depth=args.max_depth,
            include_paths=args.include_paths,
            exclude_paths=args.exclude_paths,
            max_pages=args.max_pages,
            ignore_query_parameters=args.ignore_query_parameters,
            retry=True,
            **extra,
        )
    except ApiError as e:
        die(e)

    job_id = result.get("id", "")
    if not job_id:
        die("No job ID returned")

    info(f"Crawl started: {job_id}")

    if args.no_poll:
        if JSON_OUTPUT:
            emit(f"Crawl job ID: {job_id}", {"job_id": job_id, "status": "started"})
        else:
            log(f"Crawl job ID: {job_id}")
        return

    log(f"Crawl job {job_id} — polling...")
    poll_errors = 0
    max_poll_errors = 3
    while True:
        time.sleep(POLL_INTERVAL)
        try:
            status = client.crawl_status(job_id)
        except ApiError as e:
            poll_errors += 1
            if poll_errors >= max_poll_errors:
                die(f"Lost connection to server while polling crawl status: {e}")
            warn(f"Status check failed ({poll_errors}/{max_poll_errors}): {e}")
            continue

        poll_errors = 0  # reset on success
        s = status.get("status", "unknown")
        if s in ("completed", "finished"):
            pages = status.get("data", status.get("pages", []))
            outcome_summary = status.get("outcomeSummary", {})
            if JSON_OUTPUT:
                emit(
                    "",
                    {
                        "job_id": job_id,
                        "status": "completed",
                        "pages": pages,
                        "outcomeSummary": outcome_summary,
                    },
                )
            else:
                print(f"\nCrawl completed — {len(pages)} pages:\n")
                for page in pages:
                    u = page.get("url", page.get("metadata", {}).get("sourceURL", "?"))
                    print(f"  {u}")
                if not pages and outcome_summary.get("reason"):
                    print(f"\nOutcome: {outcome_summary['reason']}")

            # Download images from all pages if --download-images flag is set
            if args.download_images:
                all_images: list[dict] = []
                for page in pages:
                    page_images = page.get("images", [])
                    if page_images:
                        all_images.extend(page_images)
                if all_images:
                    result = _download_images(all_images)
                    log(
                        f"\nDownloaded {result['downloaded']}/{result['total']} images"
                        f" ({result['skipped']} skipped) to _images/"
                    )
            return
        elif s in ("failed", "error"):
            die(f"Crawl failed: {status.get('error', 'unknown')}")
        else:
            info(f"  Status: {s}")


def cmd_followup(client: Client, args: argparse.Namespace) -> None:
    """Preview an explicit follow-up from a JSON request contract."""
    raw = args.request
    if raw.startswith("@"):
        with open(raw[1:]) as handle:
            raw = handle.read()
    try:
        body = json.loads(raw)
    except ValueError as exc:
        die(f"Invalid follow-up JSON: {exc}")
    if not isinstance(body, dict):
        die("Follow-up request must be a JSON object")
    for option in ("webhook", "as_of"):
        value = getattr(args, option, None)
        if value is not None:
            if not getattr(args, "execute", False):
                die("--webhook and --as-of require --execute")
            if option in body and body[option] != value:
                die(f"Conflicting {option} values in JSON and command option")
            body[option] = value
    if getattr(args, "execute", False):
        key = getattr(args, "idempotency_key", None)
        if not key:
            die("--execute requires --idempotency-key")
        result = client.followup_execute(body, key)
    else:
        result = client.followup_preview(body)
    if not client.dry_run and not result.get("success"):
        die(result.get("error", "Follow-up preview failed"))
    emit(json.dumps(result, indent=2), result)


def cmd_research(client: Client, args: argparse.Namespace) -> None:
    """Run an opt-in experimental research client operation."""
    action = getattr(args, "research_action", None)
    if action == "capabilities":
        result = client.experimental_research_capabilities()
        if client.dry_run:
            emit("[dry-run] Would inspect experimental research capabilities", result)
            return
        if not result.get("protocol_version"):
            die(f"Research capabilities failed: {result.get('error', 'unknown error')}")
        if JSON_OUTPUT:
            emit("", result)
            return
        print(f"Experimental research protocol: {result['protocol_version']}")
        print(f"Stage: {result['implementation_stage']}")
        print(f"Recovery: {result['recovery_mode']}")
        for name, operation in result.get("operations", {}).items():
            state = (
                "available"
                if operation.get("available")
                else f"pending ({operation.get('reason', 'not yet advertised')})"
            )
            print(f"  {name}: {state}")
        return

    try:
        if action == "workspace":
            result = client.experimental_research_workspace(
                args.run_id,
                offset=args.offset,
                limit=args.limit,
                run_offset=args.run_offset,
                expected_revision=args.expected_revision,
            )
            emit("Retained research workspace", result)
        elif action == "resume":
            result = client.experimental_research_resume(
                args.run_id,
                args.operation,
                expected_revision=args.expected_revision,
                layer=args.layer,
                snapshot_id=args.snapshot_id,
                session_id=args.session_id,
                expected_session_revision=args.expected_session_revision,
                ref_id=args.ref_id,
                start=args.start,
                end=args.end,
                wording=args.wording,
                selected=json.loads(args.selected) if args.selected else [],
            )
            emit("Named research workspace action", result)
        elif action == "create":
            result = client.experimental_research_create(
                args.objective,
                idempotency_key=args.idempotency_key,
                webhook=args.webhook,
            )
            emit(f"Research run admitted: {result.get('run_id', '?')}", result)
        elif action in {"status", "watch"}:
            if client.dry_run:
                result = client.experimental_research_status(args.run_id)
                emit("[dry-run] Would inspect experimental research run", result)
                return
            while True:
                result = client.experimental_research_status(args.run_id)
                if action == "status" or result.get("state") in {
                    "completed",
                    "failed",
                    "cancelled",
                }:
                    emit(f"Research run {result.get('state', 'unknown')}", result)
                    return
                if JSON_OUTPUT:
                    emit("", result)
                else:
                    info(f"Research run: {result.get('state', 'unknown')}")
                time.sleep(POLL_INTERVAL)
        elif action == "cancel":
            result = client.experimental_research_cancel(args.run_id)
            emit(f"Research cancellation: {result.get('state', 'unknown')}", result)
        elif action == "show":
            result = client.experimental_research_artifact_set(args.artifact_set_id)
            emit("Experimental research artifact set", result)
        elif action == "evidence":
            result = client.experimental_research_evidence(
                args.research_id, args.snapshot_id
            )
            emit("Experimental research evidence", result)
        elif action == "download":
            content = client.experimental_research_artifact_bytes(args.artifact_id)
            if client.dry_run:
                emit(
                    "[dry-run] Would download experimental research artifact",
                    {"artifact_id": args.artifact_id},
                )
            elif args.output:
                with open(args.output, "wb") as handle:
