                emit(
                    f"Wrote artifact to {args.output}",
                    {
                        "artifact_id": args.artifact_id,
                        "path": args.output,
                        "bytes": len(content),
                    },
                )
            else:
                sys.stdout.buffer.write(content)
        elif action == "delete":
            result = client.experimental_research_delete(args.research_id)
            emit("Experimental research deleted", result)
        elif action == "attach":
            result = client.experimental_research_attach(
                args.session_id, args.run_id, args.expected_revision
            )
            emit("Experimental research attached to session", result)
        else:
            die("research requires a supported action")
    except ApiError as error:
        die(error)


