    def _request(
        self,
        method: str,
        path: str,
        json_data: dict | None = None,
        params: dict | None = None,
        retry: bool = False,
        operation: str = "",
        request_headers: dict[str, str] | None = None,
    ) -> dict[str, Any]:
        import requests

        url = self._url(path)

        if self.dry_run:
            return {
                "dry_run": True,
                "method": method.upper(),
                "url": url,
                "params": params,
                "json": json_data,
            }

        # Read API key from environment (GROKTOCRAWL_API_KEY takes precedence)
        api_key = os.getenv("GROKTOCRAWL_API_KEY") or os.getenv("API_KEY") or ""

        headers: dict[str, str] = {}
        if api_key:
            headers["Authorization"] = f"Bearer {api_key}"
        if request_headers:
            headers.update(request_headers)

        policy = _retry_policy()
        attempt = 0
        while True:
            attempt += 1
            try:
                resp = requests.request(
                    method=method,
                    url=url,
                    params=params,
                    json=json_data,
                    headers=headers,
                    timeout=120,
                )
            except requests.ConnectionError as e:
                raise ApiError(
                    f"Cannot connect to {self.server}: {e}\n"
                    f"  Is the server running? Set --server or GROKTOCRAWL_API_URL"
                )

            if resp.status_code == 204:
                return {}

            try:
                body = resp.json()
            except (json.JSONDecodeError, ValueError):
                body = {"raw": resp.text[:500]}

            # Check for security warning header (one-time stderr warning)
            warning = resp.headers.get(SECURITY_WARNING_HEADER)
            if warning and _server_id(resp.url) not in _security_warnings_shown:
                _security_warnings_shown.add(_server_id(resp.url))
                print(f"\u26a0\ufe0f  Security warning: {warning}", file=sys.stderr)

            if retry and _is_retryable_rate_limit(resp.status_code, body):
                delay = _compute_retry_delay(body, dict(resp.headers), attempt)
                if attempt >= policy["max_attempts"]:
                    detail = body.get("error", "Rate limit exceeded")
                    raise RetryExhaustedError(
                        f"Rate limit exceeded after {attempt} attempt(s): {detail}",
                        status_code=resp.status_code,
                        body=body,
                        attempts=attempt,
                        last_delay=delay,
                    )
                print(
                    f"Rate limited ({operation or path}): retrying in {delay:.0f}s "
                    f"(attempt {attempt}/{policy['max_attempts']})",
                    file=sys.stderr,
                )
                _interruptible_sleep(delay)
                continue

            if resp.status_code >= 400:
                detail = body.get(
                    "detail", body.get("error", body.get("message", str(body)))
                )
                raise ApiError(
                    f"API error ({resp.status_code}): {detail}",
                    status_code=resp.status_code,
                    body=body,
                )

            return body

    def _post_stream_with_retry(
        self,
        path: str,
        json_data: dict[str, Any],
        operation: str,
        timeout: int = 300,
    ) -> Any:
        """POST *json_data* expecting an SSE stream, retrying rate-limited 429s.

        Returns the raw streaming ``requests.Response``. A 429 with the
        normalized ``RATE_LIMITED`` code is retried with the bounded
        ADR-0053 policy (the stream is never opened for a rejected
        request); exhaustion raises ``RetryExhaustedError``. Non-429
        errors raise ``ApiError`` and the response is closed.
        """
        import requests

        url = self._url(path)
        api_key = os.getenv("GROKTOCRAWL_API_KEY") or os.getenv("API_KEY") or ""
        headers: dict[str, str] = {}
        if api_key:
            headers["Authorization"] = f"Bearer {api_key}"

        policy = _retry_policy()
        attempt = 0
        while True:
            attempt += 1
            resp = requests.post(
                url, json=json_data, headers=headers, timeout=timeout, stream=True
            )
            if resp.status_code < 400:
                return resp

            try:
                body = resp.json()
            except (json.JSONDecodeError, ValueError):
                body = {"raw": resp.text[:500]}

            if _is_retryable_rate_limit(resp.status_code, body):
                delay = _compute_retry_delay(body, dict(resp.headers), attempt)
                if attempt >= policy["max_attempts"]:
                    resp.close()
                    detail = body.get("error", "Rate limit exceeded")
                    raise RetryExhaustedError(
                        f"Rate limit exceeded after {attempt} attempt(s): {detail}",
                        status_code=resp.status_code,
                        body=body,
                        attempts=attempt,
                        last_delay=delay,
                    )
                print(
                    f"Rate limited ({operation}): retrying in {delay:.0f}s "
                    f"(attempt {attempt}/{policy['max_attempts']})",
                    file=sys.stderr,
                )
                resp.close()
                _interruptible_sleep(delay)
                continue

            detail = body.get(
                "detail",
                body.get("error", body.get("message", resp.text[:500])),
            )
            resp.close()
            raise ApiError(
                f"API error ({resp.status_code}): {detail}",
                status_code=resp.status_code,
                body=body,
            )

    def scrape(
