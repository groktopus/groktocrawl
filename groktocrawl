    def search(
        self,
        query: str,
        limit: int = 5,
        scrape: bool = False,
        categories: list[str] | None = None,
        sources: list[str] | None = None,
        search_type: str = "fast",
        retrieval_mode: str = "keyword",
        output_schema: dict | None = None,
        system_prompt: str | None = None,
        date_from: str | None = None,
        date_to: str | None = None,
        time_range: str | None = None,
        engines: list[str] | None = None,
        contents: dict | None = None,
        page: int = 1,
        offset: int = 0,
    ) -> dict[str, Any]:
        bounded = date_from is not None or date_to is not None or time_range is not None
        expected = {"date_from": date_from, "date_to": date_to}
        if bounded:
            import re
            from datetime import date

            try:
                for value in expected.values():
                    if value is not None:
                        if not isinstance(value, str) or not re.fullmatch(
                            r"[0-9]{4}-[0-9]{2}-[0-9]{2}", value
                        ):
                            raise ValueError("Date bounds require YYYY-MM-DD")
                        date.fromisoformat(value)
                if date_from and date_to and date_from > date_to:
                    raise ValueError("date_from must not exceed date_to")
                if (
                    time_range is not None
                    or engines != ["openalex"]
                    or search_type not in (None, "fast")
                    or retrieval_mode not in (None, "keyword")
                    or output_schema is not None
                    or contents is not None
                    or scrape
                    or sources not in (None, [], ["web"])
                    or categories not in (None, [], ["research"], ["science"])
                ):
                    raise ValueError(
                        "Date bounds require fast keyword OpenAlex search without enrichment or time_range"
                    )
            except ValueError as exc:
                raise ApiError(str(exc), status_code=422) from exc
        data: dict[str, Any] = {
            "query": query,
            "limit": limit,
            "search_type": search_type,
            "retrieval_mode": retrieval_mode,
        }
        if page != 1 or offset:
            data.update(page=page, offset=offset)
        if scrape:
            data["scrapeOptions"] = {"formats": ["markdown"]}
        for key, value in {
            "date_from": date_from,
            "date_to": date_to,
            "time_range": time_range,
            "engines": engines,
        }.items():
            if value is not None:
                data[key] = value
        if categories:
            data["categories"] = categories
        if sources:
            data["sources"] = sources
        if output_schema:
            data["output_schema"] = output_schema
        if system_prompt:
            data["system_prompt"] = system_prompt
        if contents:
            data["contents"] = contents
        result = self._request("POST", "/search", json_data=data)
        if not bounded:
            return result
        if result.get("success") is not True or result.get("error"):
            raise ApiError(
                "Agent did not confirm bounded search success", status_code=502
            )
        proof = result.get("date_filter")
        if not isinstance(proof, dict) or (
            proof.get("requested") != {**expected, "time_range": None}
            or proof.get("applied") != expected
            or proof.get("status") != "enforced"
            or proof.get("engines") != ["openalex"]
            or proof.get("enforced_by") != ["upstream:openalex"]
            or not isinstance(proof.get("warnings"), list)
            or not isinstance(proof.get("reason"), str)
        ):
            raise ApiError(
                "Agent did not prove requested publication-date enforcement",
                status_code=502,
            )
        try:
            data = result["data"]
            if (
                not isinstance(data, dict)
                or data.get("images")
                or data.get("news")
                or not isinstance(data.get("web"), list)
            ):
                raise ValueError("Invalid bounded result envelope")
            for row in data["web"]:
                published = row.get("publishedDate")
                if (
                    not isinstance(published, str)
                    or date.fromisoformat(published).isoformat() != published
                ):
                    raise ValueError("Missing publication date")
                if (
                    row.get("engine", "openalex") != "openalex"
                    or (date_from and published < date_from)
                    or (date_to and published > date_to)
                ):
                    raise ValueError("Out-of-range publication date")
        except (KeyError, TypeError, ValueError, AttributeError):
            raise ApiError(
                "Agent returned invalid bounded publication dates", status_code=502
            )
        return result

    def search_stream(
        self,
        query: str,
        limit: int = 5,
        categories: list[str] | None = None,
        sources: list[str] | None = None,
        search_type: str = "fast",
        retrieval_mode: str = "keyword",
        output_schema: dict | None = None,
        system_prompt: str | None = None,
        date_from: str | None = None,
        date_to: str | None = None,
        time_range: str | None = None,
        engines: list[str] | None = None,
    ):
        """Search with SSE streaming.

        Returns a dict with ``_stream`` key containing the raw streaming response.
        """
        if date_from is not None or date_to is not None or time_range is not None:
            raise ApiError(
                "Bounded publication search does not support streaming", status_code=422
            )
        data: dict[str, Any] = {
            "query": query,
            "limit": limit,
            "search_type": search_type,
            "retrieval_mode": retrieval_mode,
            "stream": True,
        }
        for key, value in {
            "date_from": date_from,
            "date_to": date_to,
            "time_range": time_range,
            "engines": engines,
        }.items():
            if value is not None:
                data[key] = value
        if categories:
            data["categories"] = categories
        if sources:
            data["sources"] = sources
        if output_schema:
            data["output_schema"] = output_schema
        if system_prompt:
            data["system_prompt"] = system_prompt

        resp = self._post_stream_with_retry("/search", data, "search", timeout=120)
        return {"_stream": resp}

