def cmd_search(client: Client, args: argparse.Namespace) -> None:
    if client.dry_run:
        emit(
            f"[dry-run] Would search: {args.query}",
            {"dry_run": True, "command": "search", "query": args.query},
        )
        return

    try:
        # Parse output_schema from JSON string or file
        output_schema = None
        if args.output_schema:
            try:
                if args.output_schema.startswith("@"):
                    with open(args.output_schema[1:]) as f:
                        output_schema = json.loads(f.read())
                else:
                    output_schema = json.loads(args.output_schema)
            except (json.JSONDecodeError, FileNotFoundError) as e:
                die(f"Invalid output_schema: {e}")

        # Parse contents from JSON string or file
        contents = None
        if args.contents:
            try:
                if args.contents.startswith("@"):
                    with open(args.contents[1:]) as f:
                        contents = json.loads(f.read())
                else:
                    contents = json.loads(args.contents)
            except (json.JSONDecodeError, FileNotFoundError) as e:
                die(f"Invalid contents: {e}")

        # Map --search-type images to sources=["images"]
        search_type = args.search_type
        sources = args.sources
        if args.search_type == "images":
            sources = ["images"]
            search_type = "fast"

        if args.stream and (
            getattr(args, "page", 1) != 1 or getattr(args, "offset", 0)
        ):
            die("Search page/offset requires omitting --stream")
        if args.stream:
            result = client.search_stream(
                query=args.query,
                limit=args.limit,
                categories=args.categories,
                sources=sources,
                search_type=search_type,
                retrieval_mode=args.retrieval_mode,
                output_schema=output_schema,
                system_prompt=args.system_prompt,
                date_from=args.date_from,
                date_to=args.date_to,
                time_range=args.time_range,
                engines=args.engines,
            )
            resp = result["_stream"]
            shown_header = False
            result_count = 0
            stream_error: str | None = None
            token_started = False
            token_received = False
            try:
                for line in resp.iter_lines(decode_unicode=True):
                    if not line or not line.startswith("data: "):
                        continue
                    data_str = line[6:].strip()
                    if data_str == "[DONE]":
                        break
                    try:
                        event = json.loads(data_str)
                    except json.JSONDecodeError:
                        continue
                    event_type = event.get("type")
                    if event_type == "error":
                        stream_error = str(
                            event.get("content") or "Search stream failed"
                        )
                    if JSON_OUTPUT:
                        emit("", event)
                    elif event_type == "search_result":
                        row = event.get("result", {})
                        result_count += 1
                        if not shown_header:
                            print(f"Search results for: {args.query}\n")
                            shown_header = True
                        print(f"{result_count}. {row.get('title', '(no title)')}")
                        print(f"   {row.get('url', '')}")
                        description = row.get("description", "")
                        if description:
                            print(f"   {description[:200]}")
                        print()
                    elif event_type == "token":
                        if not token_started:
                            print("Answer:")
                            token_started = True
                        token_received = True
                        sys.stdout.write(str(event.get("content", "")))
                        sys.stdout.flush()
                    elif event_type == "done":
                        if token_started:
                            print()
                        output = event.get("output")
                        if isinstance(output, dict):
                            content = output.get("content")
                            if content is not None and not token_received:
                                label = (
                                    "Structured output:"
                                    if args.output_schema
                                    or isinstance(content, (dict, list))
                                    else "Answer:"
                                )
                                print(label)
                                if isinstance(content, (dict, list)):
                                    print(json.dumps(content, indent=2))
                                else:
                                    print(content)
                        variations = event.get("query_variations")
                        if variations:
                            print("Search queries: " + ", ".join(map(str, variations)))
                    elif event_type == "error":
                        print(f"Error: {stream_error}", file=sys.stderr)
            finally:
                close = getattr(resp, "close", None)
                if close is not None:
                    close()
            if stream_error is not None:
                die(f"Search stream failed: {stream_error}")
            return

        result = client.search(
            query=args.query,
            limit=args.limit,
            scrape=args.scrape_results,
            categories=args.categories,
            sources=sources,
            search_type=search_type,
            retrieval_mode=args.retrieval_mode,
            output_schema=output_schema,
            system_prompt=args.system_prompt,
            contents=contents,
            **(
                {"page": args.page, "offset": args.offset}
                if getattr(args, "page", 1) != 1 or getattr(args, "offset", 0)
                else {}
            ),
            date_from=args.date_from,
            date_to=args.date_to,
            time_range=args.time_range,
            engines=args.engines,
        )
    except ApiError as e:
        die(e)

    if not JSON_OUTPUT and result.get("coverage"):
        coverage = result["coverage"]
        log(
            f"Returned {coverage.get('returned_results', 0)} of {coverage.get('captured_results', 0)} captured page results; upstream completeness unknown."
        )
        if result.get("continuation"):
            log(
                f"Continue with --page {result['continuation']['page']} --offset {result['continuation']['offset']}"
            )
    data = result.get("data", {}).get("web", [])
    image_data = result.get("data", {}).get("images", [])

    # Show structured output if present
    if JSON_OUTPUT:
        output_data = {"results": data, "query": args.query}
        if result.get("coverage") is not None:
            output_data["coverage"] = result["coverage"]
            output_data["continuation"] = result.get("continuation")
        if image_data:
            output_data["images"] = image_data
        if result.get("date_filter"):
            output_data["date_filter"] = result["date_filter"]
        for key in ("evidence_coverage", "output", "query_variations", "warning"):
            if key in result:
                output_data[key] = result[key]
        emit("", output_data)
        return

    if not data and not image_data:
        log(f"No results for '{args.query}'")
        return

    if image_data and not data:
        # Image-only results
        print(f"Image search results for: {args.query}\n")
        for i, item in enumerate(image_data[: args.limit], 1):
            title = item.get("title", "(no title)")
            img_url = item.get("image_url", item.get("imageUrl", ""))
            source_url = item.get("url", "")
            w = item.get("image_width") or item.get("imageWidth")
            h = item.get("image_height") or item.get("imageHeight")
            dims = f" ({w}x{h})" if w and h else ""
            print(f"{i}. {title}{dims}")
            print(f"   {img_url}")
            if source_url and source_url != img_url:
                print(f"   Source: {source_url}")
            print()
        return

    if data:
        print(f"Search results for: {args.query}\n")
        for i, item in enumerate(data[: args.limit], 1):
            if isinstance(item, dict):
                title = item.get("title", "(no title)")
                url = item.get("url", "")
                desc = item.get("description", "")
                print(f"{i}. {title}")
                if url:
                    print(f"   {url}")
                if desc:
                    print(f"   {desc[:150]}")
                print()

    if image_data:
        print(f"\n--- Images ({len(image_data)}) ---")
        for i, item in enumerate(image_data[:10], 1):
            title = item.get("title", "(no title)")
            img_url = item.get("image_url", item.get("imageUrl", ""))
            source_url = item.get("url", "")
            w = item.get("image_width") or item.get("imageWidth")
            h = item.get("image_height") or item.get("imageHeight")
            dims = f" ({w}x{h})" if w and h else ""
            print(f"{i}. {title}{dims}")
            print(f"   {img_url}")
            if source_url and source_url != img_url:
                print(f"   Source: {source_url}")
            print()


